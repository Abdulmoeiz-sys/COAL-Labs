module ha(sum, carry, a, b);
input a, b;
output sum, carry;

xor(sum, a, b);
and(carry, a, b);

endmodule

module FA(SUM, Cout, A, B, Cin);
input A, B, Cin;
output SUM, Cout;

wire Sum1, C1, C2;

ha ha1(Sum1, C1, A, B);
ha ha2(SUM, C2, Sum1, Cin);
or(Cout, C1, C2);

endmodule

module FA_testbench;
reg A,B,Cin;
wire SUM, Cout;

FA FA1(SUM,Cout,A,B,Cin);
initial
begin
A = 0; B = 0; Cin = 0;
#10 
A = 0; B = 0; Cin = 1;
#10 
A = 0; B = 1; Cin = 0;
#10
A = 0; B = 1; Cin = 1;
#10 
A = 1; B = 0; Cin = 0;
#10
A = 1; B = 0; Cin = 1;
#10
A = 1; B = 1; Cin = 0;
#10 
A = 1; B = 1; Cin = 1;
end
endmodule


